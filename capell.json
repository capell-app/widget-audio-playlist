{
    "manifest-version": 3,
    "name": "capell-app/widget-audio-playlist",
    "slug": "widget-audio-playlist",
    "displayName": "Audio Playlist Widget",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Up to 20 uploaded tracks with native controls, artwork, transcripts, and chapters.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\WidgetAudioPlaylist",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\WidgetAudioPlaylist\\Providers\\WidgetAudioPlaylistServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "content-widget",
            "key": "capell-app.audio-playlist",
            "class": "Capell\\WidgetAudioPlaylist\\WidgetAudioPlaylistContribution"
        },
        {
            "type": "asset",
            "key": "resource-group:capell-app.widget-audio-playlist",
            "class": "Capell\\WidgetAudioPlaylist\\WidgetAudioPlaylistContribution"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "setupParams": [],
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["frontend.public-static"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 12,
        "adminQueryBudget": 0,
        "cacheTags": ["widget-audio-playlist"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale", "theme"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                },
                {
                    "model": "Capell\\Core\\Models\\Media",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "widget-audio-playlist.package-health",
            "label": "Audio Playlist widget package health",
            "class": "Capell\\WidgetAudioPlaylist\\Health\\WidgetAudioPlaylistHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Accessible native audio playlists with transcripts and chapters.",
        "description": "Add podcasts, briefings and guided audio to a page as an ordered playlist with native browser controls, optional artwork, transcripts and up to fifty chapters per track. Requires Layout Builder. Limits: one to twenty tracks per playlist, and every track must use an audio file uploaded to the Capell media library (no streaming or third-party URLs).",
        "problem": "Editors sharing audio need a way to give listeners context alongside the tracks.",
        "outcome": "A page has a local audio playlist with optional supporting transcript and chapter content.",
        "faq": [
            {
                "question": "Can playlists use remote audio?",
                "answer": "No. Audio and artwork must use local media paths."
            },
            {
                "question": "How many tracks fit in a playlist?",
                "answer": "A playlist must contain between 1 and 20 tracks."
            },
            {
                "question": "What supporting material can visitors access?",
                "answer": "The player can show transcripts and chapter markers when supplied."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/listing-audio-playlist-public-output.png",
                "alt": "Audio Playlist public output",
                "caption": "Audio Playlist public output"
            },
            {
                "path": "docs/assets/marketplace/listing-audio-playlist-layout-builder-editor.png",
                "alt": "Audio Playlist fields in Layout Builder",
                "caption": "Audio Playlist fields in Layout Builder"
            },
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Audio Playlist widget preview",
                "caption": "Audio Playlist widget"
            }
        ],
        "categories": ["foundation", "frontend", "media"]
    }
}
